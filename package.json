{
  "name": "little-video-editor",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && npm run check:server && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node scripts/verify.mjs",
    "test:keyboard": "node scripts/verify-keyboard-editor.mjs",
    "test:engine": "tsx --test tests/engine.test.ts",
    "test:agent": "node scripts/verify-agent.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "test:bridge": "node --test tests/bridge.test.mjs",
    "test:chat": "tsx --test tests/chat.test.ts",
    "check:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/core-mt": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/hashes": "2.4.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "mediabunny": "^1.58.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
