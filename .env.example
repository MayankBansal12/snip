TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0

# Website build: enable hosted MCP (origin only; do not append /mcp).
# Example: https://snip-mcp.mayank.fyi. Leave empty for local setup by default.
VITE_SNIP_MCP_ORIGIN=

# Hosted relay runtime. Node does not load .env.local automatically.
# Compose defaults to https://snip-mcp.mayank.fyi; Render uses RENDER_EXTERNAL_URL.
SNIP_RELAY_ORIGIN=
SNIP_APP_ORIGINS=https://snip.mayank.fyi
# Optional exact origins for web-based MCP clients; editor origins are separate.
SNIP_CLIENT_ORIGINS=
# Set only for a known trusted reverse proxy; the Render blueprint uses one hop.
SNIP_TRUST_PROXY=0
